{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Actsistant: main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "API_PORT": "5006"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
